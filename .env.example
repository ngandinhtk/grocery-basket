# Configure these as hosted environment variables. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Enable PayPal checkout only when accepting Premium payments.
PAYPAL_CHECKOUT_ENABLED=false
# HTTPS donation page to encode in the separate Buy a coffee QR.
COFFEE_URL=
# Alternatively, an HTTPS image containing your bank payment QR.
COFFEE_QR_IMAGE_URL=
COFFEE_DETAILS=
# Google OAuth web application credentials. Register the deployed origin's
# /auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
